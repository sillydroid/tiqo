# ==============================================================================
# TIKO — Party for Less | Environment Configuration
# ==============================================================================

# Supabase (auto-populated in Supabase Edge Functions environment)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 1. FinoQ Africa / PayHero M-Pesa API Credentials
# Used by Edge Functions to trigger real-time M-Pesa STK push
FINOQ_API_KEY=your_finoq_api_key
FINOQ_API_SECRET=your_finoq_api_secret
FINOQ_CHANNEL_ID=your_channel_id

# (Alternative naming aliases supported)
# FINOQ_API_USERNAME=your_username
# FINOQ_API_PASSWORD=your_password
# PAYHERO_API_USERNAME=your_username
# PAYHERO_API_PASSWORD=your_password
# PAYHERO_CHANNEL_ID=your_channel_id

# 2. Admin API Key (For Tiko Admin Dashboard authentication)
ADMIN_API_KEY=tiko_admin_secret_2026
