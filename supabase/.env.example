# ==============================================================================
# SUPABASE EDGE FUNCTIONS ENVIRONMENT SECRETS (Do NOT commit real keys to Git!)
# Set these using: supabase secrets set KEY=VALUE
# Or via the Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# ==============================================================================

# Supabase Project Credentials (Automatically injected in hosted Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# PayHero Kenya / FinoQ Credentials (From your PayHero dashboard -> Developer APIs)
# https://app.payhero.co.ke or https://app.finoq.africa
PAYHERO_API_USERNAME=your_payhero_api_username
PAYHERO_API_PASSWORD=your_payhero_api_password

# Your Registered Payment Channel ID on PayHero (The numeric ID of your M-Pesa Till / Paybill)
PAYHERO_CHANNEL_ID=123
